{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roundzero",
  "preview_urls": true,
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "keep_vars": true,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "5634bacd1c09247fdaa26ef02fbcf6ef",
    "AI_GATEWAY_ID": "roundzero"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>",
      "localConnectionString": "postgres://postgres:password@localhost:6311/postgres?sslmode=disable"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESUMES",
      "bucket_name": "roundzero-assets"
    }
  ],
  "workflows": [
    {
      "name": "pre-evaluation",
      "binding": "PRE_EVALUATION",
      "class_name": "PreEvaluationWorkflow"
    },
    {
      "name": "post-evaluation",
      "binding": "POST_EVALUATION",
      "class_name": "PostEvaluationWorkflow"
    },
    {
      "name": "batch-orchestration",
      "binding": "BATCH_ORCHESTRATION",
      "class_name": "BatchOrchestrationWorkflow"
    },
    {
      "name": "pool-check",
      "binding": "POOL_CHECK",
      "class_name": "PoolCheckWorkflow",
      "schedules": ["0 */6 * * *"]
    },
    {
      // Sweeps applications stranded in `evaluation_failed` (15 min cool-down,
      // capped at EVAL_RETRY_AUTO_CAP attempts). Faster cadence than the pool
      // check because a hung pre/post-eval blocks a single candidate's whole
      // application and we want to recover quickly.
      "name": "eval-retry",
      "binding": "EVAL_RETRY",
      "class_name": "EvalRetryWorkflow",
      "schedules": ["*/30 * * * *"]
    }
  ]
}
