{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roundzero",
  "preview_urls": true,
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Cloudflare AI Gateway routing for OpenRouter.
    // Secrets (OPENROUTER_API_KEY, AI_GATEWAY_TOKEN) live in `.dev.vars`
    // locally and `wrangler secret put` in prod.
    // Docs: https://developers.cloudflare.com/ai-gateway/usage/providers/openrouter/
    //
    // INTERVIEW_MODEL: leave empty to let the app pick the env-appropriate
    // chain (free models in dev, frontier Anthropic models in prod). Set it
    // to a specific model id (e.g. "anthropic/claude-sonnet-4.5") to force one.
    "CLOUDFLARE_ACCOUNT_ID": "5634bacd1c09247fdaa26ef02fbcf6ef",
    "AI_GATEWAY_ID": "roundzero",
    "INTERVIEW_MODEL": ""
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<YOUR_HYPERDRIVE_CONFIG_ID>",
      "localConnectionString": "postgres://postgres:password@localhost:6311/postgres?sslmode=disable"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESUMES",
      "bucket_name": "roundzero-assets"
    }
  ],
  "workflows": [
    {
      "name": "pre-evaluation",
      "binding": "PRE_EVALUATION",
      "class_name": "PreEvaluationWorkflow"
    },
    {
      "name": "post-evaluation",
      "binding": "POST_EVALUATION",
      "class_name": "PostEvaluationWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INTERVIEW_AGENT",
        "class_name": "InterviewAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InterviewAgent"]
    }
  ]
}
