NODE_ENV="development"
DATABASE_URL="postgres://postgres:password@localhost:6311/postgres?sslmode=disable"
TEST_DATABASE_URL="postgres://postgres:password@localhost:6312/postgres?sslmode=disable"
SESSION_SECRET="xxx"
VITE_GOOGLE_CLIENT_ID="xxx"
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
VITE_PUBLIC_ASSET_BASE_URL="https://assets.tryroundzero.com"

# Cloudflare Email Service — from address must use an onboarded sending domain.
EMAIL_FROM="notifications@tryroundzero.com"

# Polar
POLAR_ACCESS_TOKEN="polar_oat_xxx"
POLAR_WEBHOOK_SECRET="polar_whs_xxx"
POLAR_MODE="sandbox"
POLAR_PRODUCT_ID_STARTER="xxx"
POLAR_PRODUCT_ID_GROWTH="xxx"
POLAR_PRODUCT_ID_SCALE="xxx"

# OpenRouter via Cloudflare AI Gateway
# Used by the interview agent (Zero) for streaming + tool calling.
# Docs: https://developers.cloudflare.com/ai-gateway/usage/providers/openrouter/
#
# CLOUDFLARE_ACCOUNT_ID + AI_GATEWAY_ID route requests through the gateway;
# leave both empty to talk to OpenRouter directly (no caching/observability).
# AI_GATEWAY_TOKEN is only required when "Authenticated Gateway" is enabled.
CLOUDFLARE_ACCOUNT_ID=""
AI_GATEWAY_ID=""
AI_GATEWAY_TOKEN=""
OPENROUTER_API_KEY=""

# ElevenLabs Conversational AI (voice assessment)
# Create an agent in https://elevenlabs.io/app/agents and put its ID here.
# ELEVENLABS_WEBHOOK_SECRET is the HMAC secret configured on the post-call
# webhook in the ElevenLabs dashboard. Point that webhook at
# /api/voice-webhook. Leave the secret empty in dev to skip
# signature verification (the webhook is optional in local development).
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""

# Platform admin (comma-separated allowlist; leave empty to disable /admin)
PLATFORM_ADMIN_EMAILS="you@example.com"

# Sentry
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope
SENTRY_AUTH_TOKEN=""

# Hyperdrive (production only)
# Create with: wrangler hyperdrive create roundzero-db --connection-string="postgres://user:pass@host:5432/db"
# Then copy the ID into wrangler.jsonc hyperdrive.id
