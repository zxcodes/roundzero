{
  "name": "roundzero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "deploy:staging": "vite build && wrangler deploy --env staging --secrets-file .env.staging",
    "deploy:production": "vite build && wrangler deploy --env production --secrets-file .env.production",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "sqlgen": "sqlc generate",
    "db:reset": "bash db/reset.sh",
    "db:seed:me": "bun ./db/seed/seed-me.ts",
    "db:migrate": "dbmate migrate up --url $DATABASE_URL",
    "check": "biome check . --write && bun typecheck",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "setup": "bun run setup.ts",
    "prepare": "husky",
    "listen": "polar listen http://localhost:3000/api/polar/webhook",
    "cron": "curl http://localhost:3000/cdn-cgi/handler/scheduled?format=json"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.12.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.6",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@polar-sh/sdk": "^0.48.1",
    "@react-email/components": "^1.0.12",
    "@react-oauth/google": "^0.13.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/cloudflare": "^10.59.0",
    "@sentry/tanstackstart-react": "^10.59.0",
    "@snaplet/copycat": "^6.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/ai": "^0.32.0",
    "@tanstack/ai-client": "^0.18.0",
    "@tanstack/ai-openrouter": "^0.14.0",
    "@tanstack/ai-react": "^0.15.9",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@tanstack/zod-adapter": "^1.167.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docutext": "^1.2.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "2.5.0",
    "@cloudflare/vite-plugin": "^1.42.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dbmate": "^2.33.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
