{
  "name": "roundzero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:app dev:edge",
    "dev:app": "vite dev",
    "dev:edge": "cd app/edge && wrangler dev",
    "deploy:edge": "cd app/edge && wrangler deploy",
    "typegen:edge": "cd app/edge && wrangler types",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sqlgen": "sqlc generate",
    "db:seed": "bun run seed.ts",
    "db:seed:me": "bun ./db/seed/seed-me.ts",
    "db:seed:dashboard": "bun ./db/seed/seed-dashboard-company.ts",
    "db:migrate": "dbmate migrate up --url $DATABASE_URL",
    "check": "biome check . --write && bun typecheck",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "setup": "bun run setup.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1040.0",
    "@aws-sdk/s3-request-presigner": "^3.1040.0",
    "@cloudflare/ai-chat": "^0.6.0",
    "@cloudflare/tanstack-ai": "^0.1.9",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@react-email/components": "^1.0.12",
    "@react-oauth/google": "^0.13.5",
    "@snaplet/copycat": "^6.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/ai": "^0.14.0",
    "@tanstack/ai-react": "^0.8.0",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.57",
    "@tanstack/router-plugin": "^1.167.31",
    "@tanstack/zod-adapter": "^1.166.9",
    "add": "^2.0.6",
    "agents": "^0.12.0",
    "ai": "^6.0.172",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.12.16",
    "mammoth": "^1.12.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260429-beta",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "recharts": "3.8.1",
    "resend": "^6.12.2",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
