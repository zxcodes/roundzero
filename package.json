{
  "name": "roundzero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "sqlgen": "sqlc generate",
    "db:seed": "bun run seed.ts",
    "db:seed:me": "bun ./db/seed/seed-me.ts",
    "db:seed:dashboard": "bun ./db/seed/seed-dashboard-company.ts",
    "db:migrate": "dbmate migrate up --url $DATABASE_URL",
    "check": "biome check . --write && bun typecheck",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "setup": "bun run setup.ts",
    "prepare": "husky",
    "listen": "polar listen http://localhost:3000/api/polar/webhook",
    "cron": "curl http://localhost:3000/cdn-cgi/handler/scheduled"
  },
