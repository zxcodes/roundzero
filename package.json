{
  "name": "roundzero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && CLOUDFLARE_ENV=staging wrangler deploy --secrets-file .env.staging",
    "deploy:production": "CLOUDFLARE_ENV=production vite build && CLOUDFLARE_ENV=production wrangler deploy --secrets-file .env.production",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "sqlgen": "sqlc generate",
    "db:reset": "bash db/reset.sh",
    "db:seed": "bun ./seed.ts",
    "db:migrate": "dbmate migrate up --url $DATABASE_URL",
    "check": "oxfmt && oxlint --fix && bun typecheck",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "setup": "bun run setup.ts",
    "prepare": "husky",
    "listen": "polar listen http://localhost:3000/api/polar/webhook"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.17.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@polar-sh/sdk": "^0.49.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@react-oauth/google": "^0.13.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/cloudflare": "^10.69.0",
    "@sentry/tanstackstart-react": "^10.69.0",
    "@snaplet/copycat": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.42.0",
    "@tanstack/ai-client": "^0.22.1",
    "@tanstack/ai-openrouter": "^0.15.10",
    "@tanstack/ai-react": "^0.18.1",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.34",
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/zod-adapter": "^1.167.0",
    "ai": "^7.0.47",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "date-fns": "^4.4.0",
    "docutext": "^1.2.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dbmate": "^2.34.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
