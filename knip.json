{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/client.tsx", "app/router.tsx", "app/routeTree.gen.ts", "app/routes/**/*.{ts,tsx}"],
  "project": ["app/**/*.{ts,tsx}", "app/**/*.css"],
  "ignore": ["app/components/ui/**"],
  "ignoreBinaries": ["sqlc", "polar"],
  "ignoreDependencies": [
    "@fontsource-variable/geist-mono",
    "@fontsource-variable/geist",
    "vaul",
    "@tanstack/router-plugin",
    "@snaplet/copycat"
  ],
  "exclude": ["unlisted"],
  "ignoreExportsUsedInFile": true
}
