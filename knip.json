{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/router.tsx",
    "app/routeTree.gen.ts",
    "app/routes/**/*.{ts,tsx}",
    "edge/src/worker.ts"
  ],
  "project": ["app/**/*.{ts,tsx}", "edge/src/**/*.{ts,tsx}"],
  "ignore": ["app/**/*_sql.ts", "app/components/ui/**", "edge/src/**/*_sql.ts"],
  "ignoreBinaries": ["sqlc"],
  "ignoreDependencies": [
    "@tanstack/react-devtools",
    "@tanstack/react-router-devtools",
    "@tanstack/react-query-devtools",
    "@fontsource-variable/geist-mono",
    "@fontsource-variable/geist",
    "tailwindcss",
    "tw-animate-css",
    "recharts",
    "vaul",
    "shadcn",
    "@tanstack/router-plugin",
    "@snaplet/copycat"
  ],
  "exclude": ["unlisted"]
}
