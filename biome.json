{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/app/**/*",
      "**/*.json",
      "**/vite.config.ts",
      "**/vitest.config.ts",
      "**/wrangler.jsonc",
      "!**/app/routeTree.gen.ts",
      "!**/app/**/*_sql.ts",
      "!**/app/components/ui",
      "!db/seed/**/*.ts",
      "!app/vite-env.d.ts",
      "!worker-configuration.d.ts",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": { "noFloatingPromises": "warn" },
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "warn",
        "noPositiveTabindex": "warn"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noUselessElse": "warn",
        "noDefaultExport": "warn"
      },
      "suspicious": {
        "noNonNullAssertedOptionalChain": "error",
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "error",
        "noArrayIndexKey": "off",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error", "warn", "info"]
          }
        }
      },
      "security": {},
      "correctness": {
        "useJsxKeyInIterable": "error",
        "noUnusedVariables": {
          "level": "error",
          "fix": "unsafe"
        },
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnreachable": "error",
        "useHookAtTopLevel": "error"
      },
      "complexity": {
        "noUselessStringConcat": "warn",
        "noUselessCatch": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noNonNullAssertedOptionalChain": "error" },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "app/workflows/**/*.ts",
        "app/agents/**/*.ts",
        "app/server.ts",
        "app/shared/logger.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
